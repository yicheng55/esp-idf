CONFIG_EXAMPLE_USE_SPI_ETHERNET=y
CONFIG_EXAMPLE_USE_INTERNAL_ETHERNET=n
CONFIG_EXAMPLE_SPI_ETHERNETS_NUM=1
CONFIG_EXAMPLE_USE_DM9058=y

# L2 PTP (EtherType 0x88F7) — matches DM9058 MAC driver (IEEE 802.3 transport only).
CONFIG_EXAMPLE_PTP_TRANSPORT_L2=y

CONFIG_NETUTILS_PTPD=y
CONFIG_NETUTILS_PTPD_CLIENT=y
CONFIG_NETUTILS_PTPD_SERVER=n
CONFIG_NETUTILS_PTPD_SEND_DELAYREQ=y
CONFIG_NETUTILS_PTPD_TIMEOUT_MS=60000
CONFIG_NETUTILS_PTPD_SETTIME_THRESHOLD_MS=1000
CONFIG_NETUTILS_PTPD_MAX_PATH_DELAY_NS=100000
CONFIG_NETUTILS_PTPD_DELAYREQ_AVGCOUNT=100
# Max |offset_ns - last_offset_ns| per sync to count as "stable" (was 250 ns: never met with ms-scale slew)
CONFIG_NETUTILS_PTPD_PATH_DELAY_STABILITY_NS=20000000
CONFIG_NETUTILS_PTPD_DELAYRESP_INTERVAL=4
